{$MYO_DOMAIN} {
    encode zstd gzip
    basic_auth {
        {$MYO_PROXY_USER} {$MYO_PROXY_PASSWORD_HASH}
    }

    handle_path /api/* {
        reverse_proxy pc-manager:3000 {
            header_up X-MYO-Manager-Token {$MYO_MANAGER_TOKEN}
        }
    }

    handle_path /manage/* {
        reverse_proxy pc-manager:3000 {
            header_up X-MYO-Manager-Token {$MYO_MANAGER_TOKEN}
        }
    }

    handle {
        reverse_proxy windows-vm:8006
    }
}

import /etc/caddy/sites/*.caddy
