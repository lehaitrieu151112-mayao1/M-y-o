# Template only. The installer generates private credentials on the Linux host.
MYO_DOMAIN=pc.example.com
MYO_PROXY_USER=myo
MYO_PROXY_PASSWORD=REPLACE_WITH_RANDOM_SECRET
MYO_PROXY_PASSWORD_HASH='$2a$14$REPLACE_WITH_CADDY_BCRYPT_HASH'
MYO_MANAGER_TOKEN=REPLACE_WITH_RANDOM_PRIVATE_TOKEN
MYO_MAX_PCS=10
MYO_WINDOWS_USER=myo
MYO_WINDOWS_PASSWORD=REPLACE_WITH_RANDOM_SECRET
MYO_VM_RAM=16G
MYO_VM_CPU_CORES=6
MYO_VM_DISK_SIZE=256G
MYO_WINDOWS_LANGUAGE=English
MYO_WINDOWS_REGION=en-US
MYO_WINDOWS_KEYBOARD=en-US
TZ=Asia/Ho_Chi_Minh
