# Generate at least 32 random bytes locally. Never commit the real token.
MYO_SERVER_TOKEN=replace-with-a-long-random-secret-at-least-32-characters
# Set the exact allowed front-end origin after deploying. Empty means no CORS origin is allowed.
MYO_CORS_ORIGIN=
MYO_MAX_FILE_BYTES=67108864
MYO_DEFAULT_DISK_QUOTA_BYTES=1073741824